# Supabase Project URL (from Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable/Anon Key (safe for frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Supabase Secret Key (server-side only — NEVER expose to browser)
SUPABASE_SECRET_KEY=sb_secret_your-key-here
